#!/bin/bash
# Bring the WireGuard tunnel up or down, honouring a manual override, and
# refusing to strand the machine.
#
# Called by the NetworkManager dispatcher with the SSID-derived decision, and by
# wg-toggle when the user overrides it from the bar. Install to
# /usr/local/libexec/blacksheep.wireguard/wg-ssid-apply, mode 0755, root-owned.

set -u

WG_IF=wg0
WANT="${1:-down}"
HANDSHAKE_TIMEOUT=10

OVERRIDE_FILE=/var/lib/blacksheep.wireguard/override   # persistent: auto | on | off
STATE_DIR=/run/blacksheep.wireguard                    # ephemeral: last outcome, for the bar

export PATH=/usr/local/sbin:/usr/local/bin:/usr/bin:/usr/sbin:/bin:/sbin

# Our own directories and files. A directory must be a real one owned by this
# account (root, when installed), never a link. The lock is opened without
# truncation (<>, not >) and never through a link. State files are written
# through a fresh mktemp file beside them, then renamed over the name: nothing
# planted at a predictable path is followed, truncated or waited on.
own_dir() { # dir
  install -d -m 0755 "$1" 2>/dev/null
  [[ -d $1 && ! -L $1 && $(stat -c %u "$1") == "$(id -u)" ]]
}
open_lock() { # path: onto fd 9
  if [[ -L $1 ]] || { [[ -e $1 ]] && [[ ! -f $1 ]]; }; then return 1; fi
  exec 9<>"$1"
}
put() { # path line
  local tmp
  if [[ -L $1 ]] || { [[ -e $1 ]] && [[ ! -f $1 ]]; }; then return 1; fi
  tmp=$(mktemp "$(dirname "$1")/.$(basename "$1").XXXXXX") || return 1
  if printf '%s\n' "$2" >"$tmp" && chmod 0644 "$tmp" && mv -f -T "$tmp" "$1"; then return 0; fi
  rm -f "$tmp"
  return 1
}

own_dir "$STATE_DIR" && own_dir "$(dirname "$OVERRIDE_FILE")" || {
  logger -t blacksheep-wireguard "state directories are not ours; not applying"
  exit 0
}

# NetworkManager fires events in bursts (up, then a dhcp change). Without a lock
# two wg-quick runs interleave and leave half-built state. The lock lives in our
# own root-owned directory, not the world-writable /run/lock: a root process
# must never open a path that another account could have created first.
open_lock "$STATE_DIR/apply.lock" || exit 0
flock -w 30 9 || exit 0

override=auto
[[ -r $OVERRIDE_FILE ]] && override=$(<"$OVERRIDE_FILE")

# A manual choice outranks the SSID policy in both directions -- that is the
# whole point of the override. "auto" hands the decision back to the caller.
case "$override" in
on) WANT=up ;;
off) WANT=down ;;
esac

note() { put "$STATE_DIR/last-result" "$(date +%H:%M:%S) $1"; }
tunnel_is_up() { ip link show "$WG_IF" &>/dev/null; }
last_handshake() { wg show "$WG_IF" latest-handshakes 2>/dev/null | awk 'NR==1 {print $2+0; exit}'; }

# Which wg0 this script raised, by kernel interface index. A tunnel brought up
# any other way (wg-quick by hand, another tool) gets a different index, so the
# automatic policy never tears down a tunnel it did not start. Only a forced
# "off" from the panel -- the user's explicit choice -- downs any wg0.
RAISED=$STATE_DIR/raised
ifindex() { cat "/sys/class/net/$WG_IF/ifindex" 2>/dev/null; }
mark_raised() { put "$RAISED" "$(ifindex)"; }
raised_by_us() { [[ -r $RAISED && -n $(ifindex) && $(<"$RAISED") == "$(ifindex)" ]]; }
take_down() { wg-quick down "$WG_IF" 2>/dev/null; rm -f "$RAISED"; }

case "$WANT" in
up)
  tunnel_is_up && exit 0
  if ! wg-quick up "$WG_IF" 2>/dev/null; then
    note "failed to start"
    logger -t blacksheep-wireguard "wg-quick up $WG_IF failed"
    exit 0
  fi
  mark_raised

  # A tunnel whose handshake never lands still owns its routes, which blackholes
  # traffic. Tear it back down rather than leave the machine with no path out --
  # this applies to a forced-on tunnel too: being stranded is never the ask.
  for ((i = 0; i < HANDSHAKE_TIMEOUT; i++)); do
    if (($(last_handshake) > 0)); then
      note "connected"
      logger -t blacksheep-wireguard "handshake ok on $WG_IF"
      exit 0
    fi
    sleep 1
  done

  note "no handshake"
  logger -t blacksheep-wireguard "no handshake on $WG_IF after ${HANDSHAKE_TIMEOUT}s; tearing down to preserve connectivity"
  take_down
  ;;
down)
  if ! tunnel_is_up; then
    rm -f "$RAISED"
  elif [[ $override == off ]] || raised_by_us; then
    take_down
    note "stopped"
  else
    note "up, but not started by this widget; left alone"
    logger -t blacksheep-wireguard "$WG_IF is up but was not raised by this widget; not taking it down"
  fi
  ;;
esac

exit 0
